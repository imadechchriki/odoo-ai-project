<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tâche planifiée : Analyse quotidienne -->
    <record id="ir_cron_analyze_customers" model="ir.cron">
        <field name="name">Analyse IA Clients Quotidienne</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.search([('customer_rank', '>', 0)])[:10].action_analyze_with_ai()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>